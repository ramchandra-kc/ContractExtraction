# Committed defaults. Override in .env.local (gitignored). Only VITE_* variables are read.
# Dev-server proxy target for /api (used by vite.config.ts only, never by the app).
VITE_GATEWAY_URL=http://127.0.0.1:8080
# How often the documents, document and run pages are polled, in milliseconds.
VITE_POLL_MS=5000
