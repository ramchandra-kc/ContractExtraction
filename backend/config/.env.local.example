# Copy to .env.local (gitignored) for machine-local overrides and secrets.

# API keys are looked up by the env var name stored in llm_providers.api_key_env.
# OPENROUTER_API_KEY=sk-or-...

# Example: Postgres on a different port while another stack uses 5432.
# DATABASE__URL=postgresql+psycopg://contract:contract@localhost:55432/contract_extraction
