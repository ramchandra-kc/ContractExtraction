# Shared defaults for every environment. Later files override earlier ones:
#   .env → .env.<APP_ENV> → .env.local → .env.<APP_ENV>.local → real environment variables
# Nested keys use "__". Pipeline configuration (models, prompts, RAG configs, fields) lives in the database, not here.

LOG_LEVEL=INFO

# Matches the defaults in docker/docker-compose.yml.
DATABASE__URL=postgresql+psycopg://contract:contract@localhost:55432/contract_extraction

# Relative paths resolve against the backend folder.
STORAGE__ROOT=storage
STORAGE__MAX_UPLOAD_MB=50

QDRANT__URL=http://localhost:56333
