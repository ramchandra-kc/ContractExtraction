# Gateway defaults. Later files override earlier ones: .env → .env.<APP_ENV> → .env.local → real environment.
# Nested keys use "__".

LOG_LEVEL=INFO

# The single entry point for the frontend.
GATEWAY__HOST=127.0.0.1
GATEWAY__PORT=8080
# Keep this at or below the backend's STORAGE__MAX_UPLOAD_MB (default 50): the gateway answers 413 before the body reaches the backend.
GATEWAY__MAX_UPLOAD_MB=50
# Browser origins allowed to call the API directly (the Vite dev server proxies, so it is same-origin anyway).
GATEWAY__CORS_ORIGINS=["http://localhost:5173"]

# Backend API (loopback only).
UPSTREAM__URL=http://127.0.0.1:8000
UPSTREAM__CONNECT_TIMEOUT=5
UPSTREAM__READ_TIMEOUT=60
UPSTREAM__WRITE_TIMEOUT=60
UPSTREAM__POOL_TIMEOUT=5
